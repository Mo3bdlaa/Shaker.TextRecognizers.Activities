<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <!--
    Restore sources for the solution.

    nuget.org supplies Microsoft.Recognizers.Text and the test packages.

    The workflow base types (package id "System.Activities" - UiPath's CoreWF fork,
    which provides CodeActivity, InArgument<T>, CodeActivityContext and friends) are
    published only on UiPath's public feed, not on nuget.org. Pinning the feed here
    means a fresh clone restores without any machine-level NuGet configuration.

    <clear /> ensures the build does not silently depend on whatever sources happen
    to be configured on the developer's machine or the CI agent.
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <add key="uipath-official" value="https://pkgs.dev.azure.com/uipath/Public.Feeds/_packaging/UiPath-Official/nuget/v3/index.json" protocolVersion="3" />
  </packageSources>

</configuration>
