<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0-windows</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <UseWPF>true</UseWPF>
    <RootNamespace>TextRecognizers.Design</RootNamespace>
    <AssemblyName>Shaker.TextRecognizers.Activities.Design</AssemblyName>
    <IsPackable>false</IsPackable>
    <Nullable>disable</Nullable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Shaker.TextRecognizers.Activities\Shaker.TextRecognizers.Activities.csproj" />
    <PackageReference Include="System.Activities" Version="5.0.0-20210730-02" PrivateAssets="all" />
  </ItemGroup>

  <!--
    .NET splits the workflow designer across System.Activities.Presentation (ActivityDesigner) and
    System.Activities.Metadata (IRegisterMetadata, AttributeTableBuilder, MetadataStore), and publishes
    neither - Studio supplies both at run time. Compiling still needs something with the right identity,
    so this builds against the stubs in stubs/ and lets Studio provide the real assemblies.

    Private="false" keeps the stubs out of the output and out of the package. See stubs/README.md.
  -->
  <ItemGroup>
    <ProjectReference Include="..\..\stubs\System.Activities.Presentation\System.Activities.Presentation.csproj" Private="false" />
    <ProjectReference Include="..\..\stubs\System.Activities.Metadata\System.Activities.Metadata.csproj" Private="false" />
  </ItemGroup>

</Project>
