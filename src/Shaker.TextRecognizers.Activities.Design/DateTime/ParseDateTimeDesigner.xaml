<sap:ActivityDesigner x:Class="TextRecognizers.DateTimes.Design.ParseDateTimeDesigner"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sap="clr-namespace:System.Activities.Presentation;assembly=System.Activities.Presentation">
    <sap:ActivityDesigner.Icon>
        <DrawingBrush Stretch="Uniform">
            <DrawingBrush.Drawing>
                <!-- A clock glyph for ParseDateTime — the single best date/time. -->
                <GeometryDrawing>
                    <GeometryDrawing.Pen>
                        <Pen Brush="#5B5BD6" Thickness="2" LineJoin="Round" StartLineCap="Round" EndLineCap="Round"/>
                    </GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <GeometryGroup>
                            <EllipseGeometry Center="12,12" RadiusX="9" RadiusY="9"/>
                            <PathGeometry Figures="M 12,7 L 12,12 L 15,14"/>
                        </GeometryGroup>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingBrush.Drawing>
        </DrawingBrush>
    </sap:ActivityDesigner.Icon>
    <Grid Margin="2" MinWidth="160" MinHeight="20"/>
</sap:ActivityDesigner>
