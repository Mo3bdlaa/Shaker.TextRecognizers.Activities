<sap:ActivityDesigner x:Class="TextRecognizers.Units.Design.ParseMeasurementDesigner"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sap="clr-namespace:System.Activities.Presentation;assembly=System.Activities.Presentation">
    <sap:ActivityDesigner.Icon>
        <DrawingBrush Stretch="Uniform">
            <DrawingBrush.Drawing>
                <!-- A gauge glyph for ParseMeasurement — the single best measurement. -->
                <GeometryDrawing>
                    <GeometryDrawing.Pen>
                        <Pen Brush="#5B5BD6" Thickness="2" LineJoin="Round" StartLineCap="Round" EndLineCap="Round"/>
                    </GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <GeometryGroup>
                            <PathGeometry Figures="M 3.5,17 A 8.5,8.5 0 0 1 20.5,17"/>
                            <LineGeometry StartPoint="12,17" EndPoint="16.5,11.5"/>
                        </GeometryGroup>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingBrush.Drawing>
        </DrawingBrush>
    </sap:ActivityDesigner.Icon>
    <Grid Margin="2" MinWidth="160" MinHeight="20"/>
</sap:ActivityDesigner>
