<sap:ActivityDesigner x:Class="TextRecognizers.Numbers.Design.ParseNumberDesigner"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sap="clr-namespace:System.Activities.Presentation;assembly=System.Activities.Presentation">
    <sap:ActivityDesigner.Icon>
        <DrawingBrush Stretch="Uniform">
            <DrawingBrush.Drawing>
                <!-- A numeral one glyph for ParseNumber — the single best number. -->
                <GeometryDrawing>
                    <GeometryDrawing.Pen>
                        <Pen Brush="#5B5BD6" Thickness="2" LineJoin="Round" StartLineCap="Round" EndLineCap="Round"/>
                    </GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <GeometryGroup>
                            <PathGeometry Figures="M 9,8 L 12.5,5 L 12.5,19"/>
                            <LineGeometry StartPoint="8,19" EndPoint="17,19"/>
                        </GeometryGroup>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingBrush.Drawing>
        </DrawingBrush>
    </sap:ActivityDesigner.Icon>
    <Grid Margin="2" MinWidth="160" MinHeight="20"/>
</sap:ActivityDesigner>
