<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- net6.0-windows7.0 => UiPath "Windows" projects, and where the designers live.
         net6.0            => UiPath "Cross-platform" projects, and the fallback a host
                              resolves against when it does not want the Windows flavour.
         Both, not one. Studio reads the target-framework groups in the package manifest to
         decide which project types it supports; offering only net6.0-windows7.0 makes it
         report "This package is not compatible with Windows projects". -->
    <TargetFrameworks>net6.0;net6.0-windows</TargetFrameworks>

    <PackageId>Shaker.TextRecognizers.Activities</PackageId>
    <AssemblyName>Shaker.TextRecognizers.Activities</AssemblyName>

    <!-- Each domain lives in its own folder and its own namespace (TextRecognizers.DateTimes,
         .Numbers, .Units, .Sequences, .Choices), so there is no single root they all sit
         under. Files declare their namespace explicitly; this only seeds new ones. -->
    <RootNamespace>TextRecognizers</RootNamespace>

    <Description>Ready-to-use UiPath activities that turn natural-language text into strongly-typed values: dates and times, numbers, measurements with units, emails and URLs, and yes/no answers. Grouped by domain in the activities panel. Powered by Microsoft.Recognizers.Text and fully offline - no network calls, no model downloads.</Description>

    <!-- ===== Offline / airgapped packaging =====
         CopyLocalLockFileAssemblies brings the NuGet runtime assets (incl. the recognizer
         DLLs) into the build output so the target below can embed them into the .nupkg.
         The package then installs with no external NuGet restore. -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <TargetsForTfmSpecificBuildOutput>$(TargetsForTfmSpecificBuildOutput);IncludeRecognizerAssembliesInPackage</TargetsForTfmSpecificBuildOutput>
    <PackageReadmeFile>README.md</PackageReadmeFile>

    <!-- Shown beside the package in Studio's Manage Packages. The source vector lives in
         assets/icons/; tools/render-package-icons.py regenerates it. -->
    <PackageIcon>icon.png</PackageIcon>

    <!-- NU5100: the design assembly is placed into lib/ by path, not as build output. -->
    <NoWarn>$(NoWarn);NU5100</NoWarn>
  </PropertyGroup>

  <PropertyGroup>
    <!-- The Studio-only design assembly carries the per-activity panel icons. It can only be
         compiled where UiPath Studio is installed (System.Activities.Presentation ships with
         Studio and is published on no public feed), so a build elsewhere legitimately has no
         design DLL to embed - but packing without it produces a package whose activities have
         no icons, which is easy to ship by accident. Hence the warning below.
         Set RequireDesignAssembly=true to turn that warning into a hard error. -->
    <_DesignDll>$(MSBuildThisFileDirectory)..\Shaker.TextRecognizers.Activities.Design\bin\$(Configuration)\net6.0-windows\Shaker.TextRecognizers.Activities.Design.dll</_DesignDll>
    <RequireDesignAssembly Condition="'$(RequireDesignAssembly)' == ''">false</RequireDesignAssembly>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="icon.png" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <!-- The workflow base types (CodeActivity, InArgument<T>, …). Compile time only: the
         host - Studio and the robot - brings its own copy at run time, so PrivateAssets
         keeps it out of the package's dependencies.

         The version matters. Studio ships System.Activities 6.0.0.0, and an assembly
         compiled against a higher one cannot be loaded by it - which Studio also reports as
         "not compatible with Windows projects". This build from UiPath's own feed is the
         6.0.0.0 one. -->
    <PackageReference Include="UiPath.Workflow.Runtime" Version="6.0.0-20220401-03" PrivateAssets="all" ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup>
    <!-- One recognizer package per domain. All pure, grammar-based and entirely offline:
         no network calls, no model downloads. PrivateAssets="all" keeps them from being
         declared as external NuGet dependencies - the DLLs are embedded directly (target
         below), and they share a single copy of the large Definitions assembly. -->
    <PackageReference Include="Microsoft.Recognizers.Text.DateTime" Version="1.8.13" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Recognizers.Text.Number" Version="1.8.13" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Recognizers.Text.NumberWithUnit" Version="1.8.13" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Recognizers.Text.Sequence" Version="1.8.13" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Recognizers.Text.Choice" Version="1.8.13" PrivateAssets="all" />
  </ItemGroup>

  <!-- Embeds the full runtime closure into lib/<tfm>/ of the package so the single .nupkg is
       fully self-contained and airgapped-installable. We embed the Microsoft.Recognizers.*
       engine DLLs and the Microsoft.Extensions.* (caching) DLLs they depend on.
       System.Activities + Nito.* (the workflow runtime) are intentionally NOT embedded -
       the Studio/Robot host supplies them at run time.
       DependsOnTargets="ResolveReferences" guarantees ReferenceCopyLocalPaths is populated. -->
  <Target Name="IncludeRecognizerAssembliesInPackage" DependsOnTargets="ResolveReferences">
    <ItemGroup>
      <BuildOutputInPackage Include="@(ReferenceCopyLocalPaths)"
                            Condition="$([System.String]::Copy('%(FileName)').StartsWith('Microsoft.Recognizers')) Or $([System.String]::Copy('%(FileName)').StartsWith('Microsoft.Extensions'))" />
    </ItemGroup>
  </Target>

  <!-- The designers are built here rather than referenced: the design project references this
       one, so a ProjectReference back would be a cycle. -->
  <Target Name="BuildDesigners" BeforeTargets="GenerateNuspec" Condition="'$(NoBuild)' != 'true'">
    <MSBuild Projects="$(MSBuildThisFileDirectory)..\Shaker.TextRecognizers.Activities.Design\Shaker.TextRecognizers.Activities.Design.csproj"
             Targets="Build" Properties="Configuration=$(Configuration)" />
  </Target>

  <ItemGroup>
    <!-- Windows lib folder only: lib/net6.0 is the frameworkless fallback and cannot load WPF. -->
    <None Include="$(_DesignDll)" Pack="true" PackagePath="lib/net6.0-windows7.0/" Visible="false"
          Condition="Exists('$(_DesignDll)')" />
  </ItemGroup>

  <!-- Packing without the design assembly is a real outcome, but it must never be a quiet one:
       the resulting package installs and runs fine while every activity shows a blank icon. -->
  <Target Name="WarnWhenDesignAssemblyMissing" BeforeTargets="GenerateNuspec">
    <Warning Condition="!Exists('$(_DesignDll)') And '$(RequireDesignAssembly)' != 'true'"
             Code="TRX0001"
             Text="Packing without the design assembly: every activity will have NO icon in the Studio panel. Build Shaker.TextRecognizers.Activities.Design first (needs UiPath Studio installed) and pack again. This package is not suitable for UiPath Marketplace." />
    <Error Condition="!Exists('$(_DesignDll)') And '$(RequireDesignAssembly)' == 'true'"
           Code="TRX0002"
           Text="RequireDesignAssembly=true but the design assembly was not found at $(_DesignDll). Build it first (needs UiPath Studio installed)." />
  </Target>

</Project>
