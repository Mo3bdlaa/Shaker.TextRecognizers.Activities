<sap:ActivityDesigner x:Class="TextRecognizers.DateTimes.Design.DateTimeDesigner"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sap="clr-namespace:System.Activities.Presentation;assembly=System.Activities.Presentation">
    <sap:ActivityDesigner.Icon>
        <DrawingBrush Stretch="Uniform">
            <DrawingBrush.Drawing>
                <!-- A calendar glyph for the Date/Time recognition activities. -->
                <GeometryDrawing>
                    <GeometryDrawing.Pen>
                        <Pen Brush="#5B5BD6" Thickness="2" LineJoin="Round" StartLineCap="Round" EndLineCap="Round"/>
                    </GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <GeometryGroup>
                            <RectangleGeometry Rect="3,4,18,17" RadiusX="2" RadiusY="2"/>
                            <LineGeometry StartPoint="3,9" EndPoint="21,9"/>
                            <LineGeometry StartPoint="8,2" EndPoint="8,6"/>
                            <LineGeometry StartPoint="16,2" EndPoint="16,6"/>
                        </GeometryGroup>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingBrush.Drawing>
        </DrawingBrush>
    </sap:ActivityDesigner.Icon>
    <Grid Margin="2" MinWidth="160" MinHeight="20"/>
</sap:ActivityDesigner>
