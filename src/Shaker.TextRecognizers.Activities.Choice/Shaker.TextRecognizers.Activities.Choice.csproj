<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Shaker.TextRecognizers.Activities.Choice</PackageId>
    <AssemblyName>Shaker.TextRecognizers.Activities.Choice</AssemblyName>
    <RootNamespace>TextRecognizers.Choices</RootNamespace>
    <Description>Ready-to-use UiPath activities that recognise boolean (yes / no) answers in natural-language text. Powered by Microsoft.Recognizers.Text and fully offline.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>

    <!-- Shown beside the package in Studio's Manage Packages. The glyph is the
         same one this domain's activities carry in the panel; the source vector
         lives in assets/icons/. -->
    <PackageIcon>icon.png</PackageIcon>

    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <TargetsForTfmSpecificBuildOutput>$(TargetsForTfmSpecificBuildOutput);IncludeRecognizerAssembliesInPackage</TargetsForTfmSpecificBuildOutput>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="icon.png" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Shaker.TextRecognizers.Core\Shaker.TextRecognizers.Core.csproj" PrivateAssets="all" />
    <PackageReference Include="System.Activities" Version="5.0.0-20210730-02" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Recognizers.Text.Choice" Version="1.8.13" PrivateAssets="all" />
  </ItemGroup>

  <!-- Embeds the recognizer's runtime closure into the package (offline / airgapped). -->
  <Target Name="IncludeRecognizerAssembliesInPackage" DependsOnTargets="ResolveReferences">
    <PropertyGroup>
      <_DesignDll>$(MSBuildThisFileDirectory)..\Shaker.TextRecognizers.Activities.Choice.Design\bin\$(Configuration)\$(TargetFramework)\Shaker.TextRecognizers.Activities.Choice.Design.dll</_DesignDll>
    </PropertyGroup>
    <ItemGroup>
      <BuildOutputInPackage Include="@(ReferenceCopyLocalPaths)"
                            Condition="$([System.String]::Copy('%(FileName)').StartsWith('Microsoft.Recognizers')) Or $([System.String]::Copy('%(FileName)').StartsWith('Microsoft.Extensions')) Or $([System.String]::Copy('%(FileName)').StartsWith('Shaker.TextRecognizers.Core'))" />
      <!-- Studio-only design assembly (panel icons). Lives beside the runtime DLL in lib/<tfm>/; the
           robot never loads it. Included only when the Design project has been built (build it on a
           machine with UiPath Studio installed before packing). -->
      <BuildOutputInPackage Include="$(_DesignDll)" Condition="Exists('$(_DesignDll)')" />
    </ItemGroup>
  </Target>

</Project>
